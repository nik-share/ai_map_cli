            "type": "string"
          }
        },
        "required": [
          "path",
          "hash"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "configHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "integrityHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "built-in",
            "custom"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "fingerprint"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 4,
      "type": "number"
