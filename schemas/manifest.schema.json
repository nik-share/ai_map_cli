                "type": "string"
              }
            },
            "required": [
              "path",
              "kind",
              "scope",
              "targetKind",
              "exists"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "hash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "kind": {
                "const": "directory-listing",
                "type": "string"
              },
              "path": {
                "$ref": "#/$defs/__schema1"
              },
              "scope": {
                "enum": [
                  "project",
                  "toolchain"
                ],
                "type": "string"
              }
            },
            "required": [
              "path",
              "kind",
              "scope",
              "hash"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "symlink",
                "type": "string"
              },
              "path": {
                "$ref": "#/$defs/__schema1"
              },
              "scope": {
                "enum": [
                  "project",
                  "toolchain"
                ],
                "type": "string"
              },
              "target": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "required": [
              "path",
              "kind",
              "scope",
              "target"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "hash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "kind": {
                "const": "toolchain-file",
                "type": "string"
              },
              "path": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "required": [
              "path",
              "kind",
              "hash"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "semanticResolver": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceFiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "compilerUnit": {
            "minLength": 1,
            "type": "string"
          },
          "hash": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "lines": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "path",
          "hash",
          "compilerUnit",
          "lines"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "syntaxParser": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "schemaVersion",
    "analyzerVersion",
    "producer",
    "semanticResolver",
    "syntaxParser",
    "analyzers",
    "configHash",
    "sourceFiles",
    "semanticInputs",
    "artifacts",
    "integrityHash"
