      "minLength": 1,
      "type": "string"
    },
    "analyzers": {
      "items": {
        "$ref": "#/$defs/__schema0"
      },
      "type": "array"
    },
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "hash": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
