    "semanticInputs": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "hash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "kind": {
                "const": "file",
                "type": "string"
              },
              "path": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "required": [
              "path",
              "kind",
              "hash"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "exists": {
                "type": "boolean"
              },
              "kind": {
                "const": "resolution-probe",
                "type": "string"
              },
              "path": {
                "$ref": "#/$defs/__schema1"
              },
              "scope": {
                "enum": [
                  "project",
                  "toolchain"
                ],
                "type": "string"
              },
              "targetKind": {
                "enum": [
                  "file",
                  "directory",
                  "readable-file"
