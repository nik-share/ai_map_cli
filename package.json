{
  "name": "ai-code-map",
  "version": "0.1.0-alpha.2",
  "description": "Local, deterministic semantic code maps for AI coding agents",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "ai-code-map contributors",
  "keywords": [
    "static-analysis",
    "typescript",
    "javascript",
    "react",
    "nextjs",
    "nestjs",
    "ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.1",
  "bin": {
    "ai-code-map": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config.schema.json": "./config.schema.json",
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.schema.json",
    "schemas",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:generate": "node --import tsx scripts/generate-schemas.ts",
    "schema:check": "node --import tsx scripts/generate-schemas.ts --check",
    "benchmark": "node --import tsx scripts/benchmark-parsers.ts",
    "benchmark:real-world": "node --import tsx scripts/benchmark-real-world.ts",
    "prepack": "pnpm schema:check && pnpm build"
  },
  "dependencies": {
    "@manypkg/get-packages": "^3.1.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.6",
    "typescript": "^5.9.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.45.0",
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
